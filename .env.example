NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
GEMINI_API_KEY=your-gemini-api-key-here
CRON_SECRET=pick-any-random-string-here

# Optional
# Models in priority order; the next one is used only when the previous is out of quota or failing
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Where the entity's weather comes from (Open-Meteo, no key needed)
WORLD_LAT=51.48
WORLD_LON=0
WORLD_PLACE=
# Ignore ticks that arrive sooner than this after the previous thought
TICK_MIN_SECONDS=20
